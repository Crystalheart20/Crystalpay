rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: any Firebase-signed-in user (anonymous counts — your app signs everyone in automatically)
    function isSignedIn() {
      return request.auth != null;
    }

    // ——— Core Ajo data ———
    // Everyone in the app is signed in (anonymous or email), so this blocks outside scrapers
    // while keeping Admin / Member portals working as before.
    match /groups/{groupId} {
      allow read, write: if isSignedIn();
    }
    match /members/{memberId} {
      allow read, write: if isSignedIn();
    }
    match /months/{monthId} {
      allow read, write: if isSignedIn();
    }

    // ——— Relief Fund ———
    match /reliefMembers/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefContributions/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefWithdrawals/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefRequests/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefVoteReceipts/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefBallots/{docId} {
      allow read, write: if isSignedIn();
    }
    match /reliefRepayments/{docId} {
      allow read, write: if isSignedIn();
    }

    // ——— Real Estate Pools ———
    match /developer_partners/{partnerId} {
      allow read, write: if isSignedIn();
    }
    match /properties/{propertyId} {
      allow read, write: if isSignedIn();
    }
    match /property_milestones/{milestoneId} {
      allow read, write: if isSignedIn();
    }
    match /real_estate_pools/{poolId} {
      allow read, write: if isSignedIn();
    }
    match /pool_contributions/{contributionId} {
      allow read, write: if isSignedIn();
    }
    match /pool_disputes/{docId} {
      allow read, write: if isSignedIn();
    }
    match /ownership_certificates/{docId} {
      allow read, write: if isSignedIn();
    }

    // ——— Everything else: deny ———
    // Old file had `allow read, write: if true` here which opened every future collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
